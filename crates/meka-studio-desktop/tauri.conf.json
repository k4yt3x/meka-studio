{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meka Studio",
  "mainBinaryName": "meka-studio-desktop",
  "identifier": "bot.meka.studio",
  "build": {
    "frontendDist": "start"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Meka Studio, with a Meka of its own",
    "longDescription": "Meka Studio as a desktop app: it runs a Meka of its own, keeping that Meka's config and sessions apart from any other Meka on the computer.",
    "publisher": "K4YT3X",
    "copyright": "Copyright (c) 2026 K4YT3X.",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/k4yt3x/meka-studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
